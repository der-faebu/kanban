@using Kanban.Services

<div class="p-2">
    @if (!isAdding)
    {
        <MudButton Variant="Variant.Text" FullWidth="true" OnClick="ToggleForm" StartIcon="@Icons.Material.Filled.Add" Class="justify-start text-ink-faint hover:text-ink">
            Add Card
        </MudButton>
    }
    else
    {
        <form @onsubmit="HandleSubmit" class="flex flex-col gap-2">
            <MudTextField @bind-Value="title" Placeholder="Card title" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" />
            <MudTextField @bind-Value="description" Placeholder="Description (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Lines="2" />
            <div class="flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="flex-1">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleForm" Class="flex-1">Cancel</MudButton>
            </div>
        </form>
    }
</div>

@code {
    [Parameter]
    public int ListId { get; set; }

    [Parameter]
    public EventCallback OnCardAdded { get; set; }

    [Inject]
    private ICardService CardService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private bool isAdding = false;
    private string title = string.Empty;
    private string description = string.Empty;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void ToggleForm()
    {
        isAdding = !isAdding;
        if (!isAdding)
        {
            title = string.Empty;
            description = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrEmpty(userId))
            return;

        try
        {
            await CardService.CreateCardAsync(ListId, userId, title, description);
            title = string.Empty;
            description = string.Empty;
            isAdding = false;
            await OnCardAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating card: {ex.Message}");
        }
    }
}
