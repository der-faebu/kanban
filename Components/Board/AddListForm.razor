@using Kanban.Services

<div class="min-w-[300px] rounded-lg bg-surface-2 p-3">
    @if (!isAdding)
    {
        <MudButton Variant="Variant.Text" FullWidth="true" OnClick="ToggleForm" StartIcon="@Icons.Material.Filled.Add" Class="justify-start text-ink-muted">
            Add List
        </MudButton>
    }
    else
    {
        <form @onsubmit="HandleSubmit" class="flex flex-col gap-2">
            <MudTextField @bind-Value="name" Placeholder="List name" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" />
            <div class="flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="flex-1">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleForm" Class="flex-1">Cancel</MudButton>
            </div>
        </form>
    }
</div>

@code {
    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public EventCallback OnListAdded { get; set; }

    [Inject]
    private IListService ListService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private bool isAdding = false;
    private string name = string.Empty;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void ToggleForm()
    {
        isAdding = !isAdding;
        if (!isAdding)
        {
            name = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrEmpty(userId))
            return;

        try
        {
            await ListService.CreateListAsync(BoardId, userId, name);
            name = string.Empty;
            isAdding = false;
            await OnListAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating list: {ex.Message}");
        }
    }
}
