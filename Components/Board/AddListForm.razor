@using Kanban.Services

<div class="add-list-shell @(isAdding ? "add-list-shell-active" : "")">
    @if (!isAdding)
    {
        <div class="quick-add-trigger" @onclick="ToggleForm">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            <span>Add stack</span>
        </div>
    }
    else
    {
        <form @onsubmit="HandleSubmit" class="flex flex-col gap-2">
            <MudTextField @bind-Value="name" Placeholder="List name" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" />
            <div class="flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="flex-1">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleForm" Class="flex-1">Cancel</MudButton>
            </div>
        </form>
    }
</div>

<style>
    .add-list-shell {
        min-width: 300px;
        align-self: flex-start;
        padding: 8px;
        border: 1px dashed var(--knb-border-strong);
        border-radius: var(--knb-radius-lg);
        background: transparent;
    }

    .add-list-shell-active {
        border-style: solid;
        background: var(--knb-bg-surface);
    }

    .quick-add-trigger {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        border-radius: var(--knb-radius-md);
        color: var(--knb-text-tertiary);
        font-size: 13px;
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }

    .quick-add-trigger:hover {
        background: var(--knb-bg-surface-hover);
        color: var(--knb-text-primary);
    }
</style>

@code {
    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public EventCallback OnListAdded { get; set; }

    [Inject]
    private IListService ListService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private bool isAdding = false;
    private string name = string.Empty;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void ToggleForm()
    {
        isAdding = !isAdding;
        if (!isAdding)
        {
            name = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrEmpty(userId))
            return;

        try
        {
            await ListService.CreateListAsync(BoardId, userId, name);
            name = string.Empty;
            isAdding = false;
            await OnListAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating list: {ex.Message}");
        }
    }
}
