@page "/board/{BoardId:int}"
@page "/board/{BoardId:int}/card/{CardId:int}"
@rendermode InteractiveServer
@using Kanban.Services
@using Kanban.Data.Entities
@using Microsoft.AspNetCore.SignalR.Client
@attribute [StreamRendering(enabled: true)]
@attribute [Authorize]
@implements IAsyncDisposable

@if (board != null)
{
    <div class="mb-6">
        <MudText Typo="Typo.h4" Class="mb-1">@board.Name</MudText>
        @if (!string.IsNullOrEmpty(board.Description))
        {
            <MudText Typo="Typo.body2" Class="text-ink-muted">@board.Description</MudText>
        }
    </div>

    <div class="flex gap-5 overflow-x-auto pb-3" ondragover="event.preventDefault()">
        @if (lists != null)
        {
            @foreach (var list in lists.OrderBy(l => l.Position))
            {
                <ListComponent
                    List="list"
                    BoardId="BoardId"
                    BoardName="@board.Name"
                    OnCardMoved="HandleCardMoved"
                    OnListReordered="HandleListReordered"
                    @key="list.Id" />
            }
        }
        <AddListForm BoardId="BoardId" OnListAdded="HandleListAdded" />
    </div>
}
else if (loading)
{
    <MudText Class="text-ink-muted">Loading board...</MudText>
}
else
{
    <MudText Class="text-ink-muted">Board not found.</MudText>
}

<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast toast-@(toast.Kind.ToString().ToLowerInvariant())" @key="toast.Id">@toast.Text</div>
    }
</div>

<style>
    .toast-container {
        position: fixed;
        top: 16px;
        right: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 1000;
    }

    .toast {
        background: var(--knb-bg-surface);
        color: var(--knb-text-primary);
        border: 1px solid var(--knb-border);
        border-left: 3px solid var(--knb-accent);
        padding: 10px 16px;
        border-radius: var(--knb-radius-md);
        font-size: 14px;
        box-shadow: var(--knb-shadow-md);
        animation: toast-in 0.2s ease-out;
    }

    .toast-success {
        border-left-color: var(--knb-success);
    }

    .toast-danger {
        border-left-color: var(--knb-danger);
    }

    .toast-info {
        border-left-color: var(--knb-accent);
    }

    @@keyframes toast-in {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public int? CardId { get; set; }

    [Inject]
    private IBoardService BoardService { get; set; } = null!;

    [Inject]
    private IListService ListService { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private IJwtTokenService JwtTokenService { get; set; } = null!;

    private Board? board;
    private System.Collections.Generic.List<List>? lists;
    private bool loading = true;
    private string? userId;
    private HubConnection? hubConnection;
    private int? openDialogForCardId;
    private readonly System.Collections.Generic.List<ToastMessage> toasts = [];

    private enum ToastKind { Success, Info, Danger }

    private record ToastMessage(string Id, string Text, ToastKind Kind);

    private async Task ShowToast(string text, ToastKind kind)
    {
        var toast = new ToastMessage(Guid.NewGuid().ToString(), text, kind);

        await InvokeAsync(() =>
        {
            toasts.Add(toast);
            StateHasChanged();
        });

        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() =>
        {
            toasts.Remove(toast);
            StateHasChanged();
        }));
    }

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        await LoadBoardData();
        await InitializeSignalR();
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Opening the dialog here (not OnParametersSetAsync) matters: on a deep-linked
        // first load, BoardView is still mid-streaming-render ([StreamRendering]), and
        // MudDialogProvider (in MainLayout) hasn't finished registering its component ID
        // with the renderer yet. Calling DialogService.ShowAsync that early throws
        // "The renderer does not have a component with ID N". OnAfterRenderAsync only
        // fires once the tree has actually rendered, so the provider is ready by then.
        if (CardId.HasValue && CardId != openDialogForCardId && board != null)
        {
            openDialogForCardId = CardId;
            await OpenCardDialog(CardId.Value);
        }
    }

    private async Task OpenCardDialog(int cardId)
    {
        var parameters = new DialogParameters<CardDetail>
        {
            { x => x.BoardId, BoardId },
            { x => x.CardId, cardId },
            { x => x.BoardName, board?.Name ?? string.Empty },
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = false,
            CloseOnNavigation = true,
            BackdropClick = true,
        };

        var dialog = await DialogService.ShowAsync<CardDetail>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is int nextCardId)
        {
            // CardDetail closed itself with the target card's id (a parent/sub-card link was
            // clicked) rather than being dismissed. Chain straight into the next card's dialog
            // in code, instead of a NavigationManager.NavigateTo the dialog's own
            // CloseOnNavigation would race against this method's continuation.
            openDialogForCardId = nextCardId;
            NavigationManager.NavigateTo($"/board/{BoardId}/card/{nextCardId}", replace: true);
            await OpenCardDialog(nextCardId);
            return;
        }

        openDialogForCardId = null;
        if (CardId.HasValue)
        {
            NavigationManager.NavigateTo($"/board/{BoardId}", replace: true);
        }
        await LoadBoardData();
        StateHasChanged();
    }

    private async Task LoadBoardData()
    {
        try
        {
            board = await BoardService.GetBoardByIdAsync(BoardId, userId);
            lists = await ListService.GetBoardListsAsync(BoardId, userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading board: {ex.Message}");
        }
    }

    private async Task InitializeSignalR()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/sync"), options =>
            {
                // This connection is opened from server-side component code, not the browser,
                // so it never carries the user's Identity cookie. Authenticate it with a
                // short-lived JWT instead, minted fresh on every (re)connect attempt.
                options.AccessTokenProvider = () => Task.FromResult<string?>(JwtTokenService.CreateToken(userId!));
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<dynamic>("CardCreated", async (data) => await OnCardCreated(data));
        hubConnection.On<dynamic>("CardUpdated", async (data) => await OnCardUpdated(data));
        hubConnection.On<dynamic>("CardMoved", async (data) => await OnCardMoved(data));
        hubConnection.On<dynamic>("CardDeleted", async (data) => await OnCardDeleted(data));
        hubConnection.On<dynamic>("CardPriorityChanged", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("ListCreated", async (data) => await OnListCreated(data));
        hubConnection.On<dynamic>("ListUpdated", async (data) => await OnListUpdated(data));
        hubConnection.On<dynamic>("ListReordered", async (data) => await OnListReordered(data));
        hubConnection.On<dynamic>("ListDeleted", async (data) => await OnListDeleted(data));
        hubConnection.On<dynamic>("LabelAdded", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("LabelRemoved", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("AssigneeAdded", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("AssigneeRemoved", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("CommentAdded", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("CommentDeleted", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("ChecklistItemAdded", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("ChecklistItemUpdated", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("ChecklistItemDeleted", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("ChecklistReordered", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("AttachmentAdded", async (data) => await OnCardBadgesChanged(data));
        hubConnection.On<dynamic>("AttachmentDeleted", async (data) => await OnCardBadgesChanged(data));

        try
        {
            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinBoardGroup", BoardId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection error: {ex.Message}");
        }
    }

    private async Task HandleCardMoved()
    {
        await LoadBoardData();
        StateHasChanged();
    }

    private async Task HandleListReordered()
    {
        await LoadBoardData();
        StateHasChanged();
    }

    private async Task HandleListAdded()
    {
        await LoadBoardData();
        StateHasChanged();
    }

    private async Task RefreshAndNotify(string message, ToastKind kind)
    {
        await LoadBoardData();
        StateHasChanged();
        await ShowToast(message, kind);
    }

    private Task OnCardCreated(dynamic data) => RefreshAndNotify("A card was added", ToastKind.Success);
    private Task OnCardUpdated(dynamic data) => RefreshAndNotify("A card was updated", ToastKind.Info);
    private Task OnCardMoved(dynamic data) => RefreshAndNotify("A card was moved", ToastKind.Info);
    private Task OnCardDeleted(dynamic data) => RefreshAndNotify("A card was removed", ToastKind.Danger);
    private Task OnListCreated(dynamic data) => RefreshAndNotify("A list was added", ToastKind.Success);
    private Task OnListUpdated(dynamic data) => RefreshAndNotify("A list was renamed", ToastKind.Info);
    private Task OnListReordered(dynamic data) => RefreshAndNotify("Lists were reordered", ToastKind.Info);
    private Task OnListDeleted(dynamic data) => RefreshAndNotify("A list was removed", ToastKind.Danger);
    private Task OnCardBadgesChanged(dynamic data) => RefreshAndNotify("A card was updated", ToastKind.Info);

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
