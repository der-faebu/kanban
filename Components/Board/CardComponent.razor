@using Kanban.Services
@using Kanban.Data
@using Kanban.Data.Entities

<div class="card @(isDragging ? "dragging" : "")" draggable="true" @ondragstart="HandleDragStart" @ondragend="HandleDragEnd" @onclick="OpenCard">
    <div class="card-content">
        @if (labels.Count > 0 || projects.Count > 0)
        {
            <div class="label-row">
                @foreach (var label in labels)
                {
                    <span class="label-pill" style="background-color:@label.Color;color:@CardVisualStyles.ContrastText(label.Color)">@label.Name</span>
                }
                @foreach (var project in projects)
                {
                    <span class="project-pill" style="background-color:@project.Color;color:@CardVisualStyles.ContrastText(project.Color)">📁 @project.Name</span>
                }
            </div>
        }
        <span class="card-id">@CardVisualStyles.IdCode(BoardName, Card.Id)</span>
        <h3 class="@(Card.State == CardState.Done ? "done" : "")">@Card.Title</h3>
        @if (!string.IsNullOrEmpty(Card.Description))
        {
            <p>@Card.Description</p>
        }
        <div class="badge-row">
            <span class="state-badge" style="@StateStyle(Card.State)">@CardStateStyles.Label(Card.State)</span>
            @if (Card.Type.HasValue)
            {
                <span class="type-badge">@CardTypeStyles.Label(Card.Type.Value)</span>
            }
            @if (Card.Priority.HasValue)
            {
                <span class="priority-badge" style="@PriorityStyle(Card.Priority.Value)">@CardPriorityStyles.Label(Card.Priority.Value)</span>
            }
            @if (Card.DueDate.HasValue)
            {
                <span class="meta-pill" title="Due date" style="@DueDateStyle(Card.DueDate.Value, Card.State)">📅 @Card.DueDate.Value.ToShortDateString()</span>
            }
            @if (subCardTotal > 0)
            {
                <span class="meta-pill" title="Sub-card progress">☰ @subCardDone/@subCardTotal done</span>
            }
            @if (checklistTotal > 0)
            {
                <span class="meta-pill" title="Checklist progress">☑ @checklistDone/@checklistTotal</span>
            }
            @if (commentCount > 0)
            {
                <span class="meta-pill" title="@commentCount comment(s)">💬 @commentCount</span>
            }
            @if (attachmentCount > 0)
            {
                <span class="meta-pill" title="@attachmentCount attachment(s)">📎 @attachmentCount</span>
            }
            @if (assignees.Count > 0)
            {
                <div class="avatar-row">
                    @foreach (var assignee in assignees)
                    {
                        var (bg, fg) = CardVisualStyles.AvatarColor(assignee.UserName ?? assignee.Email ?? assignee.Id);
                        <span class="assignee-badge" style="background-color:@bg;color:@fg" title="@(assignee.UserName ?? assignee.Email)">@Initials(assignee)</span>
                    }
                </div>
            }
        </div>
    </div>
    <div @onclick:stopPropagation="true">
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       Class="card-delete p-1"
                       OnClick="HandleDelete"
                       title="Delete" />
    </div>
</div>

<style>
    .card {
        background: var(--knb-bg-surface-2);
        border: 1px solid var(--knb-border);
        border-radius: var(--knb-radius-md);
        padding: 12px;
        cursor: grab;
        user-select: none;
        transition: box-shadow 0.15s, transform 0.15s, opacity 0.15s, border-color 0.15s;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

    .card:hover {
        border-color: var(--knb-border-strong);
        box-shadow: var(--knb-shadow-md);
        transform: translateY(-2px);
    }

    .card:active {
        cursor: grabbing;
    }

    .card.dragging {
        opacity: 0.5;
    }

    .card-content {
        flex: 1;
        min-width: 0;
    }

    .card h3 {
        margin: 0 0 4px 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--knb-text-primary);
        word-break: break-word;
    }

    .card h3.done {
        text-decoration: line-through;
    }

    .card p {
        margin: 0;
        font-size: 12px;
        color: var(--knb-text-secondary);
        word-break: break-word;
    }

    .card-id {
        display: block;
        margin-bottom: 2px;
        font-family: var(--knb-font-mono);
        font-size: 10px;
        letter-spacing: 0.03em;
        color: var(--knb-text-tertiary);
    }

    .card-delete {
        color: var(--knb-text-tertiary);
        flex-shrink: 0;
    }

        .card-delete:hover {
            color: var(--knb-danger);
        }

    .label-row {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 6px;
    }

    .label-pill, .project-pill {
        display: inline-block;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.6;
        padding: 1px 8px;
        border-radius: var(--knb-radius-full);
    }

    .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 6px;
        align-items: center;
    }

    .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        color: var(--knb-text-secondary);
        background: var(--knb-bg-surface-3);
        padding: 1px 7px;
        border-radius: var(--knb-radius-full);
    }

    .avatar-row {
        display: flex;
        margin-left: auto;
        gap: 4px;
    }

    .assignee-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
    }

    .priority-badge,
    .state-badge,
    .type-badge {
        display: inline-flex;
        align-items: center;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: 1px 6px;
        border-radius: var(--knb-radius-full);
    }

    .type-badge {
        color: var(--knb-text-secondary);
        background: var(--knb-bg-surface-3);
    }
</style>

@code {
    [Parameter]
    public Card Card { get; set; } = null!;

    [Parameter]
    public int ListId { get; set; }

    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnCardMoved { get; set; }

    [Inject]
    private ICardService CardService { get; set; } = null!;

    [Inject]
    private ICommentService CommentService { get; set; } = null!;

    [Inject]
    private IChecklistService ChecklistService { get; set; } = null!;

    [Inject]
    private IAttachmentService AttachmentService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [Inject]
    private DragDropState DragState { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private string? userId;
    private List<Label> labels = [];
    private List<Project> projects = [];
    private List<ApplicationUser> assignees = [];
    private int commentCount;
    private int checklistDone;
    private int checklistTotal;
    private int attachmentCount;
    private int subCardDone;
    private int subCardTotal;
    private bool isDragging;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadBadges();
    }

    private async Task LoadBadges()
    {
        if (string.IsNullOrEmpty(userId))
            return;

        try
        {
            labels = await CardService.GetCardLabelsAsync(Card.Id, userId);
            projects = await CardService.GetCardProjectsAsync(Card.Id, userId);
            assignees = await CardService.GetCardAssigneesAsync(Card.Id, userId);
            commentCount = await CommentService.GetCardCommentCountAsync(Card.Id, userId);
            (checklistDone, checklistTotal) = await ChecklistService.GetChecklistProgressAsync(Card.Id, userId);
            attachmentCount = await AttachmentService.GetAttachmentCountAsync(Card.Id, userId);

            if (!Card.ParentCardId.HasValue)
            {
                (subCardDone, subCardTotal) = await CardService.GetSubCardProgressAsync(Card.Id, userId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading card badges: {ex.Message}");
        }
    }

    private static string PriorityStyle(CardPriority priority)
    {
        var (fg, bg) = CardPriorityStyles.Colors(priority);
        return $"color:{fg};background-color:{bg}";
    }

    private static string StateStyle(CardState state)
    {
        var (fg, bg) = CardStateStyles.Colors(state);
        return $"color:{fg};background-color:{bg}";
    }

    private static string DueDateStyle(DateTime dueDate, CardState state)
    {
        var (fg, bg) = CardDueDateStyles.Colors(dueDate, state);
        return $"color:{fg};background-color:{bg}";
    }

    private static string Initials(ApplicationUser user)
    {
        var name = user.UserName ?? user.Email ?? "?";
        return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private void OpenCard()
    {
        NavigationManager.NavigateTo($"/board/{BoardId}/card/{Card.Id}");
    }

    private void HandleDragStart(DragEventArgs e)
    {
        e.DataTransfer.EffectAllowed = "move";
        DragState.DraggedCardId = Card.Id;
        DragState.SourceListId = ListId;
        isDragging = true;
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        isDragging = false;
    }

    private async Task HandleDelete()
    {
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                await CardService.SoftDeleteCardAsync(Card.Id, userId);
                await OnCardMoved.InvokeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting card: {ex.Message}");
            }
        }
    }
}
