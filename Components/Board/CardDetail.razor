@using Kanban.Services
@using Kanban.Data
@using Kanban.Data.Entities
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@implements IAsyncDisposable

<MudDialog Options="dialogOptions">
    <DialogContent>
        <div class="card-dialog-header">
            <div class="card-dialog-header-main">
                @if (found)
                {
                    <span class="card-id">@CardVisualStyles.IdCode(BoardName, CardId)</span>
                    <MudTextField @bind-Value="title" Immediate="true" OnBlur="SaveCardFields" Variant="Variant.Text"
                                  Placeholder="Card title" Class="card-title-field" />
                }
                else
                {
                    <MudText Typo="Typo.h6">Card details</MudText>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" />
        </div>

        @if (loading)
        {
            <MudText Class="text-ink-muted">Loading card...</MudText>
        }
        else if (!found)
        {
            <MudText Class="text-ink-muted">This card doesn't exist, was deleted, or you don't have access to it.</MudText>
        }
        else
        {
            <div class="card-dialog-body">
                <div class="prop-row">
                    <MudSelect T="CardState" Value="state" ValueChanged="HandleStateChanged" Placeholder="State"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control">
                        @foreach (var s in Enum.GetValues<CardState>())
                        {
                            <MudSelectItem T="CardState" Value="s">@CardStateStyles.Label(s)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="CardType?" Value="type" ValueChanged="HandleTypeChanged" Placeholder="Type"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="prop-control">
                        @foreach (var t in Enum.GetValues<CardType>())
                        {
                            <MudSelectItem T="CardType?" Value="t">@CardTypeStyles.Label(t)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="CardPriority?" Value="priority" ValueChanged="HandlePriorityChanged" Placeholder="Priority"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="prop-control">
                        @foreach (var level in Enum.GetValues<CardPriority>())
                        {
                            <MudSelectItem T="CardPriority?" Value="level">@CardPriorityStyles.Label(level)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Date="dueDate" DateChanged="HandleDueDateChanged" Placeholder="Due date"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Editable="true" Class="prop-control" />
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Labels</MudText>
                    <div class="pill-flow">
                        @foreach (var label in cardLabels)
                        {
                            <span class="label-pill" style="background-color:@label.Color;color:@CardVisualStyles.ContrastText(label.Color)">
                                @label.Name
                                <button type="button" class="pill-remove" @onclick="() => RemoveLabel(label.Id)">&times;</button>
                            </span>
                        }
                        @foreach (var label in boardLabels.Where(l => !cardLabels.Any(cl => cl.Id == l.Id)))
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Style="@($"border-color:{label.Color};color:{label.Color}")" OnClick="() => AddLabel(label.Id)">+ @label.Name</MudChip>
                        }
                    </div>
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Projects</MudText>
                    <div class="pill-flow">
                        @foreach (var project in cardProjects)
                        {
                            <span class="project-pill" style="background-color:@project.Color;color:@CardVisualStyles.ContrastText(project.Color)">
                                📁 @project.Name
                                <button type="button" class="pill-remove" @onclick="() => RemoveProject(project.Id)">&times;</button>
                            </span>
                        }
                        @foreach (var project in allProjects.Where(p => !cardProjects.Any(cp => cp.Id == p.Id)))
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Style="@($"border-color:{project.Color};color:{project.Color}")" OnClick="() => AddProject(project.Id)">+ 📁 @project.Name</MudChip>
                        }
                    </div>

                    <MudLink Href="/projects" Target="_blank" Class="mt-2 inline-block" Underline="Underline.Hover">Manage projects</MudLink>
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Assignees</MudText>
                    <div class="pill-flow mb-2">
                        @foreach (var assignee in cardAssignees)
                        {
                            var (bg, fg) = CardVisualStyles.AvatarColor(assignee.UserName ?? assignee.Email ?? assignee.Id);
                            <span class="assignee-pill">
                                <span class="assignee-pill-avatar" style="background-color:@bg;color:@fg">@Initials(assignee)</span>
                                @(assignee.UserName ?? assignee.Email)
                                <button type="button" class="pill-remove" @onclick="() => RemoveAssignee(assignee.Id)">&times;</button>
                            </span>
                        }
                    </div>
                    <MudSelect T="string" Value="selectedAssigneeId" ValueChanged="AddAssignee" Placeholder="Assign someone..."
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control">
                        @foreach (var member in boardMembers.Where(m => !cardAssignees.Any(a => a.Id == m.UserId)))
                        {
                            <MudSelectItem T="string" Value="@member.UserId">@(member.User?.UserName ?? member.User?.Email)</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Dev reference link</MudText>
                    @if (editingDevReferenceUrl)
                    {
                        <MudTextField @bind-Value="devReferenceUrl" Immediate="true" OnBlur="SaveDevReferenceUrl" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Placeholder="https://github.com/org/repo/pull/1" AutoFocus="true" FullWidth="true" />
                    }
                    else if (!string.IsNullOrWhiteSpace(devReferenceUrl))
                    {
                        <p class="link-text" @onclick="() => editingDevReferenceUrl = true">
                            <a href="@devReferenceUrl" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">@DevLinkStyles.ProviderIcon(devReferenceUrl) @devReferenceUrl</a>
                        </p>
                    }
                    else
                    {
                        <p class="description-placeholder" @onclick="() => editingDevReferenceUrl = true">Add a GitHub PR or Azure DevOps PBI link...</p>
                    }
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Ticket link</MudText>
                    @if (editingTicketUrl)
                    {
                        <MudTextField @bind-Value="ticketUrl" Immediate="true" OnBlur="SaveTicketUrl" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Placeholder="https://example.atlassian.net/browse/PROJ-1" AutoFocus="true" FullWidth="true" />
                    }
                    else if (!string.IsNullOrWhiteSpace(ticketUrl))
                    {
                        <p class="link-text" @onclick="() => editingTicketUrl = true">
                            <a href="@ticketUrl" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">🔗 @ticketUrl</a>
                        </p>
                    }
                    else
                    {
                        <p class="description-placeholder" @onclick="() => editingTicketUrl = true">Add a ticket system link...</p>
                    }
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Time tracking</MudText>
                    <div class="prop-row mb-2">
                        <MudNumericField T="decimal?" @bind-Value="estimatedHours" Immediate="true" OnBlur="SaveEstimatedHours"
                                         Label="Estimate (hours)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control" Min="0" />
                        <MudText Class="text-ink-muted self-center">Logged: @loggedHours.ToString("0.##")h</MudText>
                    </div>

                    <div class="mb-3 flex flex-col gap-2">
                        @foreach (var entry in timeLogEntries)
                        {
                            <div class="time-entry-row">
                                @if (editingTimeEntryId == entry.Id)
                                {
                                    <MudDatePicker Date="editingEntryDate" DateChanged="d => editingEntryDate = d" Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control" />
                                    <MudNumericField T="decimal?" @bind-Value="editingEntryHours" Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control" Placeholder="Hours" Min="0" />
                                    <MudTextField @bind-Value="editingEntryNote" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Note (optional)" FullWidth="true" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveTimeEntryEdit(entry.Id)">Save</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelEditingTimeEntry">Cancel</MudButton>
                                }
                                else
                                {
                                    <span class="time-entry-summary">
                                        <strong>@entry.DurationHours.ToString("0.##")h</strong> on @entry.Date.ToShortDateString()
                                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                                        {
                                            <span class="text-ink-muted"> &mdash; @entry.Note</span>
                                        }
                                    </span>
                                    @if (entry.UserId == userId)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => StartEditingTimeEntry(entry)">Edit</MudButton>
                                    }
                                    @if (entry.UserId == userId || isOwner)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteTimeEntry(entry.Id)">Delete</MudButton>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="flex flex-wrap gap-2 items-end">
                        <MudDatePicker Date="newEntryDate" DateChanged="d => newEntryDate = d" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control" />
                        <MudNumericField T="decimal?" @bind-Value="newEntryHours" Label="Hours" Variant="Variant.Outlined" Margin="Margin.Dense" Class="prop-control" Min="0" />
                        <MudTextField @bind-Value="newEntryNote" Placeholder="Note (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddTimeEntry" Disabled="@(newEntryHours is not > 0 || !newEntryDate.HasValue)">Log time</MudButton>
                    </div>
                </div>

                @if (parentCardId.HasValue)
                {
                    <div class="section-block">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Parent card</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => NavigateToCard(parentCardId.Value)">@(parentCardTitle ?? $"Card #{parentCardId}")</MudButton>
                    </div>
                }
                else
                {
                    <div class="section-block">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Sub-cards (@subCards.Count)</MudText>
                        <div class="mb-2 flex flex-col gap-1">
                            @foreach (var sub in subCards)
                            {
                                <div class="sub-card-row">
                                    <span class="@(sub.State == CardState.Done ? "done" : "")">@sub.Title</span>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => NavigateToCard(sub.Id)">Open</MudButton>
                                </div>
                            }
                        </div>
                        <div class="flex gap-2">
                            <MudTextField @bind-Value="newSubCardTitle" Placeholder="New sub-card title" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateSubCard" Disabled="@string.IsNullOrWhiteSpace(newSubCardTitle)">Add sub-card</MudButton>
                        </div>
                    </div>
                }

                <div class="section-block">
                    <div class="section-header">
                        <MudText Typo="Typo.subtitle2">Description</MudText>
                        @if (!editingDescription)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => editingDescription = true">Edit</MudButton>
                        }
                    </div>
                    @if (editingDescription)
                    {
                        <MudTextField @bind-Value="description" Immediate="true" OnBlur="HandleDescriptionBlur" Variant="Variant.Outlined"
                                      Placeholder="Add a more detailed description..." Lines="4" FullWidth="true" AutoFocus="true" />
                    }
                    else if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="description-text" @onclick="() => editingDescription = true">@description</p>
                    }
                    else
                    {
                        <p class="description-placeholder" @onclick="() => editingDescription = true">Add a more detailed description...</p>
                    }
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Checklist (@checklistDoneCount/@checklistItems.Count)</MudText>
                    @if (checklistItems.Count > 0)
                    {
                        <div class="checklist-progress">
                            <div class="checklist-progress-fill" style="width:@(checklistItems.Count == 0 ? 0 : checklistDoneCount * 100 / checklistItems.Count)%"></div>
                        </div>
                    }
                    <div class="mb-2 mt-2 flex flex-col gap-1">
                        @foreach (var item in checklistItems.OrderBy(i => i.Position))
                        {
                            <div class="checklist-item" draggable="true" @key="item.Id"
                                 @ondragstart="() => HandleChecklistDragStart(item)"
                                 @ondragover="(DragEventArgs _) => { }" @ondragover:preventDefault="true"
                                 @ondrop="() => HandleChecklistDrop(item)">
                                <MudCheckBox T="bool" Value="item.IsDone" ValueChanged="@(v => ToggleChecklistItem(item.Id, v))" Dense="true" />

                                @if (editingChecklistItemId == item.Id)
                                {
                                    <MudTextField @bind-Value="editingChecklistItemText" Immediate="true" OnBlur="() => SaveChecklistItemEdit(item.Id)" Variant="Variant.Text" Class="flex-1" AutoFocus="true" />
                                }
                                else
                                {
                                    <span class="checklist-item-text @(item.IsDone ? "done" : "")" @onclick="() => StartChecklistItemEdit(item)">@item.Text</span>
                                }

                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="text-ink-faint p-1" OnClick="() => DeleteChecklistItem(item.Id)" />
                            </div>
                        }
                    </div>
                    <div class="flex gap-2">
                        <MudTextField @bind-Value="newChecklistItemText" Immediate="true" Placeholder="Add checklist item" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" FullWidth="true" OnKeyDown="HandleChecklistItemKeyDown" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddChecklistItem" Disabled="@string.IsNullOrWhiteSpace(newChecklistItemText)">Add</MudButton>
                    </div>
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Comments (@comments.Count)</MudText>
                    <div class="mb-3 flex flex-col gap-3">
                        @foreach (var comment in comments)
                        {
                            <div class="comment">
                                <div class="mb-1 flex items-baseline gap-2 text-xs text-ink-muted">
                                    <strong class="text-ink">@AuthorName(comment.AuthorId)</strong>
                                    <span>@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                    @if (comment.UpdatedAt > comment.CreatedAt)
                                    {
                                        <span class="italic">(edited)</span>
                                    }
                                </div>

                                @if (editingCommentId == comment.Id)
                                {
                                    <MudTextField @bind-Value="editingCommentText" Immediate="true" OnBlur="() => SaveCommentEdit(comment.Id)" Variant="Variant.Outlined" Lines="2" FullWidth="true" Class="mb-2" AutoFocus="true" />
                                    <div class="flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveCommentEdit(comment.Id)">Save</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelCommentEdit">Cancel</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <p class="comment-text">@comment.Text</p>
                                    <div class="flex gap-2">
                                        @if (comment.AuthorId == userId)
                                        {
                                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => StartCommentEdit(comment)">Edit</MudButton>
                                        }
                                        @if (comment.AuthorId == userId || isOwner)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteComment(comment.Id)">Delete</MudButton>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <MudTextField @bind-Value="newCommentText" Placeholder="Write a comment..." Variant="Variant.Outlined" Lines="2" FullWidth="true" Class="mb-2" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="PostComment" Disabled="@string.IsNullOrWhiteSpace(newCommentText)">Post comment</MudButton>
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Attachments (@attachments.Count)</MudText>
                    <div class="mb-2 flex flex-col gap-2">
                        @foreach (var attachment in attachments)
                        {
                            <div class="attachment-row">
                                <MudLink Href="@DownloadUrl(attachment.Id)" Target="_blank" Class="font-semibold">@attachment.FileName</MudLink>
                                <span class="flex-1 text-xs text-ink-muted">@FormatSize(attachment.SizeBytes) &middot; @AuthorName(attachment.UploadedByUserId) &middot; @attachment.CreatedAt.ToLocalTime().ToString("g")</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="text-ink-faint p-1" OnClick="() => DeleteAttachment(attachment.Id)" />
                            </div>
                        }
                    </div>

                    <InputFile OnChange="HandleFileSelected"
                               class="block w-full text-sm text-ink-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-surface-3 file:px-3 file:py-2 file:text-ink hover:file:bg-surface-hover" />
                    @if (!string.IsNullOrEmpty(uploadError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@uploadError</MudAlert>
                    }
                </div>

                <div class="section-block">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Activity</MudText>
                    <div class="activity-list">
                        @foreach (var entry in activityLog)
                        {
                            <div class="activity-entry">
                                <span>@FormatActivity(entry)</span>
                                <span class="whitespace-nowrap text-ink-faint">@entry.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

<style>
    .card-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
    }

    .card-dialog-header-main {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .card-id {
        font-family: var(--knb-font-mono);
        font-size: 11px;
        letter-spacing: 0.03em;
        color: var(--knb-text-tertiary);
    }

    .card-title-field .mud-input-slot {
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--knb-text-primary);
        padding-left: 0;
    }

    .card-dialog-body {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .prop-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .prop-control {
        width: 200px;
        flex: 0 0 auto;
    }

    .section-block {
        border-top: 1px solid var(--knb-border-subtle);
        padding-top: 16px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .pill-flow {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .label-pill, .project-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 6px 3px 10px;
        border-radius: var(--knb-radius-full);
    }

    .assignee-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--knb-text-primary);
        background: var(--knb-bg-surface-3);
        padding: 3px 6px 3px 3px;
        border-radius: var(--knb-radius-full);
    }

    .assignee-pill-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
    }

    .pill-remove {
        border: none;
        background: transparent;
        color: inherit;
        opacity: 0.7;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
        padding: 0;
    }

        .pill-remove:hover {
            opacity: 1;
        }

    .description-text, .description-placeholder {
        margin: 0;
        padding: 8px 10px;
        border-radius: var(--knb-radius-md);
        cursor: text;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .description-text {
        color: var(--knb-text-primary);
    }

        .description-text:hover, .description-placeholder:hover {
            background: var(--knb-bg-surface-hover);
        }

    .description-placeholder {
        color: var(--knb-text-tertiary);
    }

    .link-text {
        margin: 0;
        padding: 8px 10px;
        border-radius: var(--knb-radius-md);
        cursor: text;
        word-break: break-all;
    }

        .link-text:hover {
            background: var(--knb-bg-surface-hover);
        }

        .link-text a {
            color: var(--knb-accent);
        }

    .checklist-progress {
        height: 6px;
        border-radius: var(--knb-radius-full);
        background: var(--knb-bg-surface-3);
        overflow: hidden;
    }

    .checklist-progress-fill {
        height: 100%;
        background: var(--knb-success);
        border-radius: var(--knb-radius-full);
        transition: width 0.2s ease-out;
    }

    .swatch {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid transparent;
        cursor: pointer;
    }

    .swatch.selected {
        border-color: var(--knb-border-strong);
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 6px;
        border-radius: var(--knb-radius-sm);
        cursor: grab;
    }

    .checklist-item:hover {
        background: var(--knb-bg-surface-hover);
    }

    .checklist-item-text {
        flex: 1;
        cursor: text;
        color: var(--knb-text-primary);
    }

    .checklist-item-text.done {
        text-decoration: line-through;
        color: var(--knb-text-tertiary);
    }

    .comment {
        background: var(--knb-bg-surface-2);
        border-radius: var(--knb-radius-md);
        padding: 8px 10px;
    }

    .comment-text {
        margin: 0;
        color: var(--knb-text-primary);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .attachment-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        background: var(--knb-bg-surface-2);
        border-radius: var(--knb-radius-md);
    }

    .time-entry-row, .sub-card-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        background: var(--knb-bg-surface-2);
        border-radius: var(--knb-radius-md);
    }

    .time-entry-summary, .sub-card-row span {
        flex: 1;
        font-size: 13px;
    }

    .sub-card-row span.done {
        text-decoration: line-through;
        color: var(--knb-text-tertiary);
    }

    .activity-list {
        display: flex;
        flex-direction: column;
