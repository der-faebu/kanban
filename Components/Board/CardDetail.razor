@page "/board/{BoardId:int}/card/{CardId:int}"
@rendermode InteractiveServer
@using Kanban.Services
@using Kanban.Data
@using Kanban.Data.Entities
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@attribute [StreamRendering(enabled: true)]
@attribute [Authorize]
@implements IAsyncDisposable

@if (loading)
{
    <MudText Class="text-ink-muted m-6">Loading card...</MudText>
}
else if (!found)
{
    <div class="mx-auto my-16 max-w-md text-center">
        <MudText Typo="Typo.h5" Class="mb-2">Card not found</MudText>
        <MudText Typo="Typo.body2" Class="text-ink-muted mb-4">This card doesn't exist, was deleted, or you don't have access to it.</MudText>
        <MudLink Href="@($"/board/{BoardId}")">&larr; Back to board</MudLink>
    </div>
}
else
{
    <MudPaper Outlined="true" Class="mx-auto my-6 max-w-3xl p-6 flex flex-col gap-6">
        <MudLink Href="@($"/board/{BoardId}")" Class="block text-sm text-ink-muted" Underline="Underline.Hover">&larr; Back to board</MudLink>

        <MudTextField @bind-Value="title" Immediate="true" OnBlur="SaveCardFields" Variant="Variant.Text"
                      Placeholder="Card title" Class="card-title-field" />

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Description</MudText>
            <MudTextField @bind-Value="description" Immediate="true" OnBlur="SaveCardFields" Variant="Variant.Outlined"
                          Placeholder="Add a more detailed description..." Lines="4" FullWidth="true" />
        </MudPaper>

        <MudDatePicker Label="Due date" Date="dueDate" DateChanged="HandleDueDateChanged" Variant="Variant.Outlined" Clearable="true" Editable="true" />

        <MudSelect T="CardPriority?" Value="priority" ValueChanged="HandlePriorityChanged" Label="Priority" Variant="Variant.Outlined" Clearable="true">
            @foreach (var level in Enum.GetValues<CardPriority>())
            {
                <MudSelectItem T="CardPriority?" Value="level">@CardPriorityStyles.Label(level)</MudSelectItem>
            }
        </MudSelect>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Labels</MudText>
            <div class="mb-2 flex flex-wrap gap-2">
                @foreach (var label in cardLabels)
                {
                    <MudChip T="string" Style="@($"background-color:{label.Color};color:#fff")" OnClose="() => RemoveLabel(label.Id)">@label.Name</MudChip>
                }
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var label in boardLabels.Where(l => !cardLabels.Any(cl => cl.Id == l.Id)))
                {
                    <MudChip T="string" Variant="Variant.Outlined" Style="@($"border-color:{label.Color};color:{label.Color}")" OnClick="() => AddLabel(label.Id)">+ @label.Name</MudChip>
                }
            </div>

            @if (isOwner)
            {
                <div class="mt-3 flex flex-col gap-2">
                    <MudTextField @bind-Value="newLabelName" Placeholder="New label name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <div class="flex flex-wrap gap-2">
                        @foreach (var color in LabelSwatches.Colors)
                        {
                            <button type="button" class="swatch @(color == newLabelColor ? "selected" : "")"
                                    style="background-color:@color" @onclick="() => newLabelColor = color"></button>
                        }
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateLabel"
                               Disabled="@string.IsNullOrWhiteSpace(newLabelName)" Class="self-start">Create label</MudButton>
                </div>

                <div class="mt-3 flex flex-wrap gap-2">
                    @foreach (var label in boardLabels)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteLabel(label.Id)">Delete "@label.Name"</MudButton>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Assignees</MudText>
            <div class="mb-2 flex flex-wrap gap-2">
                @foreach (var assignee in cardAssignees)
                {
                    <MudChip T="string" OnClose="() => RemoveAssignee(assignee.Id)">@(assignee.UserName ?? assignee.Email)</MudChip>
                }
            </div>
            <MudSelect T="string" Value="selectedAssigneeId" ValueChanged="AddAssignee" Label="Assign someone..." Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var member in boardMembers.Where(m => !cardAssignees.Any(a => a.Id == m.UserId)))
                {
                    <MudSelectItem T="string" Value="@member.UserId">@(member.User?.UserName ?? member.User?.Email)</MudSelectItem>
                }
            </MudSelect>
        </MudPaper>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Checklist (@checklistDoneCount/@checklistItems.Count)</MudText>
            <div class="mb-2 flex flex-col gap-1">
                @foreach (var item in checklistItems.OrderBy(i => i.Position))
                {
                    <div class="checklist-item" draggable="true" @key="item.Id"
                         @ondragstart="() => HandleChecklistDragStart(item)"
                         @ondragover="(DragEventArgs _) => { }" @ondragover:preventDefault="true"
                         @ondrop="() => HandleChecklistDrop(item)">
                        <MudCheckBox T="bool" Value="item.IsDone" ValueChanged="@(v => ToggleChecklistItem(item.Id, v))" Dense="true" />

                        @if (editingChecklistItemId == item.Id)
                        {
                            <MudTextField @bind-Value="editingChecklistItemText" OnBlur="() => SaveChecklistItemEdit(item.Id)" Variant="Variant.Text" Class="flex-1" AutoFocus="true" />
                        }
                        else
                        {
                            <span class="checklist-item-text @(item.IsDone ? "done" : "")" @onclick="() => StartChecklistItemEdit(item)">@item.Text</span>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="text-ink-faint p-1" OnClick="() => DeleteChecklistItem(item.Id)" />
                    </div>
                }
            </div>
            <div class="flex gap-2">
                <MudTextField @bind-Value="newChecklistItemText" Immediate="true" Placeholder="Add checklist item" Variant="Variant.Outlined"
                              Margin="Margin.Dense" FullWidth="true" OnKeyDown="HandleChecklistItemKeyDown" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddChecklistItem" Disabled="@string.IsNullOrWhiteSpace(newChecklistItemText)">Add</MudButton>
            </div>
        </MudPaper>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Comments (@comments.Count)</MudText>
            <div class="mb-3 flex flex-col gap-3">
                @foreach (var comment in comments)
                {
                    <div class="comment">
                        <div class="mb-1 flex items-baseline gap-2 text-xs text-ink-muted">
                            <strong class="text-ink">@AuthorName(comment.AuthorId)</strong>
                            <span>@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                            @if (comment.UpdatedAt > comment.CreatedAt)
                            {
                                <span class="italic">(edited)</span>
                            }
                        </div>

                        @if (editingCommentId == comment.Id)
                        {
                            <MudTextField @bind-Value="editingCommentText" Variant="Variant.Outlined" Lines="2" FullWidth="true" Class="mb-2" />
                            <div class="flex gap-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveCommentEdit(comment.Id)">Save</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelCommentEdit">Cancel</MudButton>
                            </div>
                        }
                        else
                        {
                            <p class="comment-text">@comment.Text</p>
                            <div class="flex gap-2">
                                @if (comment.AuthorId == userId)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => StartCommentEdit(comment)">Edit</MudButton>
                                }
                                @if (comment.AuthorId == userId || isOwner)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteComment(comment.Id)">Delete</MudButton>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <MudTextField @bind-Value="newCommentText" Placeholder="Write a comment..." Variant="Variant.Outlined" Lines="2" FullWidth="true" Class="mb-2" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="PostComment" Disabled="@string.IsNullOrWhiteSpace(newCommentText)">Post comment</MudButton>
        </MudPaper>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Attachments (@attachments.Count)</MudText>
            <div class="mb-2 flex flex-col gap-2">
                @foreach (var attachment in attachments)
                {
                    <div class="attachment-row">
                        <MudLink Href="@DownloadUrl(attachment.Id)" Target="_blank" Class="font-semibold">@attachment.FileName</MudLink>
                        <span class="flex-1 text-xs text-ink-muted">@FormatSize(attachment.SizeBytes) &middot; @AuthorName(attachment.UploadedByUserId) &middot; @attachment.CreatedAt.ToLocalTime().ToString("g")</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="text-ink-faint p-1" OnClick="() => DeleteAttachment(attachment.Id)" />
                    </div>
                }
            </div>

            <InputFile OnChange="HandleFileSelected"
                       class="block w-full text-sm text-ink-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-surface-3 file:px-3 file:py-2 file:text-ink hover:file:bg-surface-hover" />
            @if (!string.IsNullOrEmpty(uploadError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@uploadError</MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="p-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Activity</MudText>
            <div class="activity-list">
                @foreach (var entry in activityLog)
                {
                    <div class="activity-entry">
                        <span>@FormatActivity(entry)</span>
                        <span class="whitespace-nowrap text-ink-faint">@entry.CreatedAt.ToLocalTime().ToString("g")</span>
                    </div>
                }
            </div>
        </MudPaper>
    </MudPaper>
}

<style>
    .card-title-field .mud-input-slot {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--knb-text-primary);
    }

    .swatch {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid transparent;
        cursor: pointer;
    }

    .swatch.selected {
        border-color: var(--knb-border-strong);
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 6px;
        border-radius: var(--knb-radius-sm);
        cursor: grab;
    }

    .checklist-item:hover {
        background: var(--knb-bg-surface-hover);
    }

    .checklist-item-text {
        flex: 1;
        cursor: text;
        color: var(--knb-text-primary);
    }

    .checklist-item-text.done {
        text-decoration: line-through;
        color: var(--knb-text-tertiary);
    }

    .comment {
        background: var(--knb-bg-surface-2);
        border-radius: var(--knb-radius-md);
        padding: 8px 10px;
    }

    .comment-text {
        margin: 0;
        color: var(--knb-text-primary);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .attachment-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        background: var(--knb-bg-surface-2);
        border-radius: var(--knb-radius-md);
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-height: 300px;
        overflow-y: auto;
    }

    .activity-entry {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 13px;
        color: var(--knb-text-secondary);
        padding: 3px 0;
        border-bottom: 1px solid var(--knb-border-subtle);
    }
</style>

@code {
    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public int CardId { get; set; }

    [Inject]
    private ICardService CardService { get; set; } = null!;

    [Inject]
    private ILabelService LabelService { get; set; } = null!;

    [Inject]
    private IBoardService BoardService { get; set; } = null!;

    [Inject]
    private ICommentService CommentService { get; set; } = null!;

    [Inject]
    private IChecklistService ChecklistService { get; set; } = null!;

    [Inject]
    private IAttachmentService AttachmentService { get; set; } = null!;

    [Inject]
    private IActivityLogService ActivityLogService { get; set; } = null!;

    [Inject]
    private Microsoft.Extensions.Options.IOptions<AttachmentsOptions> AttachmentSettings { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private bool loading = true;
    private bool found = false;
    private bool isOwner = false;
    private string? userId;
    private HubConnection? hubConnection;

    private string title = string.Empty;
    private string description = string.Empty;
    private DateTime? dueDate;
    private CardPriority? priority;

    private List<Label> cardLabels = [];
    private List<Label> boardLabels = [];
    private List<ApplicationUser> cardAssignees = [];
    private List<BoardMember> boardMembers = [];
    private string? selectedAssigneeId;

    private string newLabelName = string.Empty;
    private string newLabelColor = LabelSwatches.Colors[0];

    private List<Comment> comments = [];
    private Dictionary<string, string> authorNames = new();
    private string newCommentText = string.Empty;
    private int? editingCommentId;
    private string editingCommentText = string.Empty;

    private List<ChecklistItem> checklistItems = [];
    private int checklistDoneCount => checklistItems.Count(i => i.IsDone);
    private string newChecklistItemText = string.Empty;
    private int? editingChecklistItemId;
    private string editingChecklistItemText = string.Empty;
    private int? draggedChecklistItemId;

    private int listId;
    private List<Attachment> attachments = [];
    private string? uploadError;
    private List<CardActivity> activityLog = [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        await LoadCardData();
        if (found)
        {
            await InitializeSignalR();
        }
        loading = false;
    }

    private async Task LoadCardData()
    {
        if (string.IsNullOrEmpty(userId))
            return;

        try
        {
            var card = await CardService.GetCardByIdAsync(CardId, userId);
            if (card == null || card.List == null || card.List.BoardId != BoardId)
            {
                found = false;
                return;
            }

            found = true;
            listId = card.List.Id;
            title = card.Title;
            description = card.Description;
            dueDate = card.DueDate;
            priority = card.Priority;

            cardLabels = await CardService.GetCardLabelsAsync(CardId, userId);
            boardLabels = await LabelService.GetBoardLabelsAsync(BoardId, userId);
            cardAssignees = await CardService.GetCardAssigneesAsync(CardId, userId);
            boardMembers = await BoardService.GetBoardMembersAsync(BoardId, userId);
            isOwner = await BoardService.IsUserBoardOwnerAsync(BoardId, userId);
            comments = await CommentService.GetCardCommentsAsync(CardId, userId);
            checklistItems = await ChecklistService.GetItemsAsync(CardId, userId);
            attachments = await AttachmentService.GetAttachmentsAsync(CardId, userId);
            activityLog = await ActivityLogService.GetCardActivityAsync(CardId, userId);

            authorNames = boardMembers
                .Where(m => m.User != null)
                .ToDictionary(m => m.UserId, m => m.User!.UserName ?? m.User!.Email ?? m.UserId);
            foreach (var assignee in cardAssignees)
            {
                authorNames[assignee.Id] = assignee.UserName ?? assignee.Email ?? assignee.Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading card: {ex.Message}");
            found = false;
        }
    }

    private async Task InitializeSignalR()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/sync"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<JsonElement>("CardUpdated", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("CardPriorityChanged", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("CardDeleted", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("LabelAdded", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("LabelRemoved", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("AssigneeAdded", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("AssigneeRemoved", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("CommentAdded", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("CommentUpdated", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("CommentDeleted", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("ChecklistItemAdded", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("ChecklistItemUpdated", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("ChecklistItemDeleted", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("ChecklistReordered", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("AttachmentAdded", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("AttachmentDeleted", async data => await RefreshIfForThisCard(data));
        hubConnection.On<JsonElement>("ActivityLogged", async data => await RefreshIfForThisCard(data));
        // Label create/delete change the board-wide palette (no cardId on the payload), so always refresh.
        hubConnection.On<JsonElement>("LabelCreated", async _ => await Refresh());
        hubConnection.On<JsonElement>("LabelDeleted", async _ => await Refresh());

        try
        {
            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinBoardGroup", BoardId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection error: {ex.Message}");
        }
    }

    private async Task Refresh()
    {
        await LoadCardData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshIfForThisCard(JsonElement data)
    {
        if (data.TryGetProperty("cardId", out var cardIdProp) && cardIdProp.GetInt32() == CardId)
        {
            await Refresh();
        }
    }

    private async Task SaveCardFields()
    {
        if (string.IsNullOrEmpty(userId) || !found)
            return;

        try
        {
            await CardService.UpdateCardAsync(CardId, userId, title, description, dueDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating card: {ex.Message}");
        }
    }

    private async Task HandleDueDateChanged(DateTime? newDate)
    {
        dueDate = newDate;
        await SaveCardFields();
    }

    private async Task HandlePriorityChanged(CardPriority? newPriority)
    {
        priority = newPriority;
        if (string.IsNullOrEmpty(userId) || !found)
            return;

        try
        {
            await CardService.SetCardPriorityAsync(CardId, userId, newPriority);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating card priority: {ex.Message}");
        }
    }

    private async Task AddLabel(int labelId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await CardService.AddLabelAsync(CardId, userId, labelId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding label: {ex.Message}");
        }
    }

    private async Task RemoveLabel(int labelId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await CardService.RemoveLabelAsync(CardId, userId, labelId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing label: {ex.Message}");
        }
    }

    private async Task CreateLabel()
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrWhiteSpace(newLabelName)) return;
        try
        {
            await LabelService.CreateLabelAsync(BoardId, userId, newLabelName, newLabelColor);
            newLabelName = string.Empty;
            newLabelColor = LabelSwatches.Colors[0];
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating label: {ex.Message}");
        }
    }

    private async Task DeleteLabel(int labelId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await LabelService.DeleteLabelAsync(labelId, userId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting label: {ex.Message}");
        }
    }

    private async Task AddAssignee(string? assigneeUserId)
    {
        selectedAssigneeId = null;
        if (string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(assigneeUserId)) return;
        try
        {
            await CardService.AddAssigneeAsync(CardId, userId, assigneeUserId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding assignee: {ex.Message}");
        }
    }

    private async Task RemoveAssignee(string assigneeUserId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await CardService.RemoveAssigneeAsync(CardId, userId, assigneeUserId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing assignee: {ex.Message}");
        }
    }

    private string AuthorName(string authorId) => authorNames.TryGetValue(authorId, out var name) ? name : authorId;

    private async Task AddChecklistItem()
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrWhiteSpace(newChecklistItemText)) return;
        try
        {
            await ChecklistService.AddItemAsync(CardId, userId, newChecklistItemText);
            newChecklistItemText = string.Empty;
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding checklist item: {ex.Message}");
        }
    }

    private async Task HandleChecklistItemKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddChecklistItem();
        }
    }

    private async Task ToggleChecklistItem(int itemId, bool isDone)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await ChecklistService.ToggleItemAsync(itemId, userId, isDone);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling checklist item: {ex.Message}");
        }
    }

    private void StartChecklistItemEdit(ChecklistItem item)
    {
        editingChecklistItemId = item.Id;
        editingChecklistItemText = item.Text;
    }

    private async Task SaveChecklistItemEdit(int itemId)
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrWhiteSpace(editingChecklistItemText))
        {
            editingChecklistItemId = null;
            return;
        }
        try
        {
            await ChecklistService.UpdateItemTextAsync(itemId, userId, editingChecklistItemText);
            editingChecklistItemId = null;
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error editing checklist item: {ex.Message}");
        }
    }

    private async Task DeleteChecklistItem(int itemId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await ChecklistService.DeleteItemAsync(itemId, userId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting checklist item: {ex.Message}");
        }
    }

    private void HandleChecklistDragStart(ChecklistItem item)
    {
        draggedChecklistItemId = item.Id;
    }

    private async Task HandleChecklistDrop(ChecklistItem targetItem)
    {
        if (string.IsNullOrEmpty(userId) || draggedChecklistItemId == null || draggedChecklistItemId == targetItem.Id)
            return;

        var ordered = checklistItems.OrderBy(i => i.Position).ToList();
        var dragged = ordered.FirstOrDefault(i => i.Id == draggedChecklistItemId);
        if (dragged == null) return;

        ordered.Remove(dragged);
        var targetIndex = ordered.FindIndex(i => i.Id == targetItem.Id);
        ordered.Insert(targetIndex, dragged);

        var positions = ordered.Select((item, index) => (item.Id, index)).ToList();

        try
        {
            await ChecklistService.ReorderItemsAsync(CardId, userId, positions);
            draggedChecklistItemId = null;
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reordering checklist items: {ex.Message}");
        }
    }

    private async Task PostComment()
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrWhiteSpace(newCommentText)) return;
        try
        {
            await CommentService.AddCommentAsync(CardId, userId, newCommentText);
            newCommentText = string.Empty;
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error posting comment: {ex.Message}");
        }
    }

    private void StartCommentEdit(Comment comment)
    {
        editingCommentId = comment.Id;
        editingCommentText = comment.Text;
    }

    private void CancelCommentEdit()
    {
        editingCommentId = null;
        editingCommentText = string.Empty;
    }

    private async Task SaveCommentEdit(int commentId)
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrWhiteSpace(editingCommentText)) return;
        try
        {
            await CommentService.UpdateCommentAsync(commentId, userId, editingCommentText);
            CancelCommentEdit();
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error editing comment: {ex.Message}");
        }
    }

    private async Task DeleteComment(int commentId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await CommentService.DeleteCommentAsync(commentId, userId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting comment: {ex.Message}");
        }
    }

    private string FormatActivity(CardActivity entry)
    {
        var actor = AuthorName(entry.UserId);
        JsonElement meta = default;
        if (!string.IsNullOrEmpty(entry.Metadata))
        {
            try { meta = JsonDocument.Parse(entry.Metadata).RootElement; }
            catch (JsonException) { /* malformed/legacy metadata; render without details */ }
        }

        string Get(string key) =>
            meta.ValueKind == JsonValueKind.Object && meta.TryGetProperty(key, out var v)
                ? v.ToString()
                : string.Empty;

        return entry.ActivityType switch
        {
            ActivityType.CardCreated => $"{actor} created this card",
            ActivityType.CardUpdated => $"{actor} updated the card details",
            ActivityType.CardMoved => $"{actor} moved this card",
            ActivityType.CardSoftDeleted => $"{actor} deleted this card",
            ActivityType.CardRestored => $"{actor} restored this card",
            ActivityType.LabelAdded => $"{actor} added label \"{Get("labelName")}\"",
            ActivityType.LabelRemoved => $"{actor} removed a label",
            ActivityType.AssigneeAdded => $"{actor} assigned {AuthorName(Get("assigneeUserId"))}",
            ActivityType.AssigneeRemoved => $"{actor} unassigned {AuthorName(Get("assigneeUserId"))}",
            ActivityType.CommentAdded => $"{actor} commented",
            ActivityType.CommentUpdated => $"{actor} edited a comment",
            ActivityType.CommentDeleted => $"{actor} deleted a comment",
            ActivityType.ChecklistItemAdded => $"{actor} added checklist item \"{Get("text")}\"",
            ActivityType.ChecklistItemToggled => $"{actor} {(Get("isDone") == "True" ? "checked" : "unchecked")} \"{Get("text")}\"",
            ActivityType.ChecklistItemDeleted => $"{actor} deleted checklist item \"{Get("text")}\"",
            ActivityType.AttachmentAdded => $"{actor} attached a file",
            ActivityType.AttachmentDeleted => $"{actor} removed an attachment",
            ActivityType.PriorityChanged => string.IsNullOrEmpty(Get("priority")) ? $"{actor} cleared the priority" : $"{actor} set priority to {Get("priority")}",
            _ => $"{actor} made a change"
        };
    }

    private string DownloadUrl(int attachmentId) => $"/api/lists/{listId}/cards/{CardId}/attachments/{attachmentId}/download";

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(userId)) return;
        uploadError = null;

        try
        {
            var file = e.File;
            var maxBytes = AttachmentSettings.Value.MaxFileSizeMb * 1024L * 1024L;
            await using var stream = file.OpenReadStream(maxBytes);
            await AttachmentService.UploadAttachmentAsync(CardId, userId, stream, file.Name, file.ContentType, file.Size);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
            Console.WriteLine($"Error uploading attachment: {ex.Message}");
        }
    }

    private async Task DeleteAttachment(int attachmentId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        try
        {
            await AttachmentService.DeleteAttachmentAsync(attachmentId, userId);
            await LoadCardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting attachment: {ex.Message}");
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
