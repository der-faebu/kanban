    private async Task LoadCardData()
    {
        if (string.IsNullOrEmpty(userId))
            return;

        try
        {
            var card = await CardService.GetCardByIdAsync(CardId, userId);
            if (card == null || card.List == null || card.List.BoardId != BoardId)
            {
                found = false;
                return;
            }

            found = true;
            listId = card.List.Id;
            title = card.Title;
            description = card.Description;
            dueDate = card.DueDate;
            priority = card.Priority;
            state = card.State;
            type = card.Type;
            devReferenceUrl = card.DevReferenceUrl ?? string.Empty;
            ticketUrl = card.TicketUrl ?? string.Empty;
            estimatedHours = card.EstimatedHours;
            parentCardId = card.ParentCardId;

            cardLabels = await CardService.GetCardLabelsAsync(CardId, userId);
            boardLabels = await LabelService.GetBoardLabelsAsync(BoardId, userId);
            cardProjects = await CardService.GetCardProjectsAsync(CardId, userId);
            allProjects = await ProjectService.GetAllProjectsAsync();
            cardAssignees = await CardService.GetCardAssigneesAsync(CardId, userId);
            boardMembers = await BoardService.GetBoardMembersAsync(BoardId, userId);
            isOwner = await BoardService.IsUserBoardOwnerAsync(BoardId, userId);
            comments = await CommentService.GetCardCommentsAsync(CardId, userId);
            checklistItems = await ChecklistService.GetItemsAsync(CardId, userId);
            attachments = await AttachmentService.GetAttachmentsAsync(CardId, userId);
            activityLog = await ActivityLogService.GetCardActivityAsync(CardId, userId);
            timeLogEntries = await TimeTrackingService.GetCardTimeLogEntriesAsync(CardId, userId);
            loggedHours = await TimeTrackingService.GetCardLoggedHoursAsync(CardId, userId);

            if (parentCardId.HasValue)
            {
                var parentCard = await CardService.GetCardByIdAsync(parentCardId.Value, userId);
                parentCardTitle = parentCard?.Title;
                subCards = [];
            }
            else
            {
                parentCardTitle = null;
                subCards = await CardService.GetSubCardsAsync(CardId, userId);
            }

            authorNames = boardMembers
                .Where(m => m.User != null)
                .ToDictionary(m => m.UserId, m => m.User!.UserName ?? m.User!.Email ?? m.UserId);
            foreach (var assignee in cardAssignees)
            {
                authorNames[assignee.Id] = assignee.UserName ?? assignee.Email ?? assignee.Id;
            }

            // boardMembers/cardAssignees miss anyone who acted but isn't in either list right
            // now: the board owner (never a BoardMember row, see BoardService.AddBoardMemberAsync)
            // and former members who were removed after commenting/attaching/etc. Resolve those
            // too so the activity log/comments/attachments never fall back to a raw user id.
            var unresolvedUserIds = CollectUnresolvedUserIds();

            if (unresolvedUserIds.Count > 0)
            {
                var resolved = await BoardService.GetUsersByIdsAsync(BoardId, userId, unresolvedUserIds);
                foreach (var user in resolved)
                {
                    authorNames[user.Id] = user.DisplayName;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading card: {ex.Message}");
            found = false;
        }
    }

    private List<string> CollectUnresolvedUserIds() =>
        activityLog.Select(a => a.UserId)
            .Concat(activityLog.SelectMany(GetMetadataUserIds))
            .Concat(comments.Select(c => c.AuthorId))
            .Concat(attachments.Select(a => a.UploadedByUserId))
            .Where(id => !string.IsNullOrEmpty(id) && !authorNames.ContainsKey(id))
            .Distinct()
            .ToList();

