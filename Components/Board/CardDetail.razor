    private static JsonElement ParseMetadata(string? metadataJson)
    {
        if (string.IsNullOrEmpty(metadataJson))
            return default;

        try { return JsonDocument.Parse(metadataJson).RootElement; }
        catch (JsonException) { return default; /* malformed/legacy metadata; render without details */ }
    }

    private static string GetMetadataValue(JsonElement meta, string key) =>
        meta.ValueKind == JsonValueKind.Object && meta.TryGetProperty(key, out var v) ? v.ToString() : string.Empty;

    private static IEnumerable<string> GetMetadataUserIds(CardActivity entry)
    {
        if (entry.ActivityType != ActivityType.AssigneeAdded && entry.ActivityType != ActivityType.AssigneeRemoved)
            yield break;

        var id = GetMetadataValue(ParseMetadata(entry.Metadata), "assigneeUserId");
        if (!string.IsNullOrEmpty(id))
            yield return id;
    }

    private string FormatActivity(CardActivity entry)
    {
        var actor = AuthorName(entry.UserId);
        var meta = ParseMetadata(entry.Metadata);
        string Get(string key) => GetMetadataValue(meta, key);

        return entry.ActivityType switch
        {
            ActivityType.CardCreated => $"{actor} created this card",
