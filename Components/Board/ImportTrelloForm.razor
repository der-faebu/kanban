@using Kanban.Data.Dtos
@using Kanban.Services
@inject ITrelloImportService TrelloImportService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="import-form">
    <h3>Import from Trello</h3>

    <div class="form-group">
        <label for="newBoardName">New board name:</label>
        <input
            id="newBoardName"
            type="text"
            @bind="newBoardName"
            placeholder="e.g. My Trello Board"
            class="form-control"
            disabled="@isLoading" />
    </div>

    <div class="form-group">
        <label for="trelloFile">Select Trello JSON Export:</label>
        <InputFile
            id="trelloFile"
            accept=".json"
            OnChange="OnFileSelected"
            class="form-control"
            disabled="@isLoading" />
    </div>

    @if (selectedFile != null)
    {
        <div class="alert alert-info">
            Selected: @selectedFile.Name
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <button
        class="btn btn-primary"
        @onclick="UploadFile"
        disabled="@(selectedFile == null || string.IsNullOrWhiteSpace(newBoardName) || isLoading)">
        @if (isLoading)
        {
            <span>Importing...</span>
        }
        else
        {
            <span>Import</span>
        }
    </button>
</div>

@code {
    [Parameter]
    public EventCallback<TrelloImportResult> OnImportComplete { get; set; }

    private IBrowserFile? selectedFile;
    private string newBoardName = string.Empty;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;
        selectedFile = e.File;

        if (selectedFile.Size > 5 * 1024 * 1024)
        {
            errorMessage = "File size must be less than 5 MB";
            selectedFile = null;
        }
    }

    private async Task UploadFile()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(newBoardName))
            return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "You must be signed in to import a board";
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await using var fileStream = selectedFile.OpenReadStream(5 * 1024 * 1024);
            var result = await TrelloImportService.ImportBoardAsync(userId, fileStream, newBoardName);

            if (result.Success)
            {
                successMessage = result.Message;
                selectedFile = null;
                newBoardName = string.Empty;
                await OnImportComplete.InvokeAsync(result);
            }
            else
            {
                errorMessage = result.Message ?? "Import failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error importing file: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
