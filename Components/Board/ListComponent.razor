@using Kanban.Services
@using Kanban.Data.Entities

<div class="list @(isDraggingList ? "dragging" : "")" draggable="true" @ondragstart="HandleListDragStart" @ondragend="HandleListDragEnd">
    <div class="list-header">
        <h2>@List.Name <span class="list-count">@(cards?.Count ?? 0)</span></h2>
        <div class="list-menu-wrap" @onclick:stopPropagation="true">
            <button type="button" class="list-menu-btn" @onclick="ToggleMenu" title="List options">&#8943;</button>
            @if (showMenu)
            {
                <div class="list-menu-dropdown">
                    <button type="button" class="list-menu-item" @onclick="HandleDeleteFromMenu">Delete list</button>
                </div>
            }
        </div>
    </div>

    <div class="cards-container @(isDragOverCards ? "drag-over" : "")" @ondragover="HandleCardDragOver" @ondragover:preventDefault="true" @ondrop="HandleCardDrop" @ondragleave="HandleCardDragLeave">
        @if (cards != null)
        {
            @foreach (var card in cards.OrderBy(c => c.Position))
            {
                <CardComponent
                    Card="card"
                    ListId="List.Id"
                    BoardId="BoardId"
                    BoardName="@BoardName"
                    OnCardMoved="HandleCardMoved"
                    @key="card.Id" />
            }
        }
        <AddCardForm ListId="List.Id" OnCardAdded="HandleCardAdded" />
    </div>
</div>

<style>
    .list {
        background: var(--knb-bg-surface);
        border: 1px solid var(--knb-border-subtle);
        border-radius: var(--knb-radius-lg);
        min-width: 300px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        cursor: grab;
        user-select: none;
        transition: opacity 0.15s;
    }

    .list:active {
        cursor: grabbing;
    }

    .list.dragging {
        opacity: 0.5;
    }

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .list-header h2 {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 15px;
        font-weight: 600;
        color: var(--knb-text-primary);
    }

    .list-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: var(--knb-radius-full);
        background: var(--knb-bg-surface-3);
        color: var(--knb-text-secondary);
        font-size: 11px;
        font-weight: 600;
    }

    .list-menu-wrap {
        position: relative;
    }

    .list-menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border: none;
        background: transparent;
        border-radius: var(--knb-radius-sm);
        color: var(--knb-text-tertiary);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
    }

        .list-menu-btn:hover {
            background: var(--knb-bg-surface-hover);
            color: var(--knb-text-primary);
        }

    .list-menu-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        z-index: 20;
        min-width: 140px;
        background: var(--knb-bg-surface);
        border: 1px solid var(--knb-border);
        border-radius: var(--knb-radius-md);
        box-shadow: var(--knb-shadow-md);
        padding: 4px;
    }

    .list-menu-item {
        display: block;
        width: 100%;
        text-align: left;
        padding: 6px 10px;
        border: none;
        background: transparent;
        border-radius: var(--knb-radius-sm);
        color: var(--knb-danger);
        font-size: 13px;
        cursor: pointer;
    }

        .list-menu-item:hover {
            background: var(--knb-danger-subtle);
        }

    .cards-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 50px;
        border-radius: var(--knb-radius-md);
        transition: background-color 0.15s;
    }

    .cards-container.drag-over {
        background: var(--knb-accent-subtle);
        padding: 4px;
    }
</style>

@code {
    [Parameter]
    public List List { get; set; } = null!;

    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnCardMoved { get; set; }

    [Parameter]
    public EventCallback OnListReordered { get; set; }

    [Inject]
    private IListService ListService { get; set; } = null!;

    [Inject]
    private ICardService CardService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [Inject]
    private DragDropState DragState { get; set; } = null!;

    private List<Card>? cards;
    private string? userId;
    private bool isDragOverCards = false;
    private bool isDraggingList = false;
    private bool showMenu = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadCards();
    }

    private async Task LoadCards()
    {
        if (string.IsNullOrEmpty(userId)) return;

        try
        {
            cards = await CardService.GetListCardsAsync(List.Id, userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cards: {ex.Message}");
        }
    }

    private void HandleListDragStart(DragEventArgs e)
    {
        e.DataTransfer.EffectAllowed = "move";
        DragState.DraggedListId = List.Id;
        isDraggingList = true;
    }

    private void HandleListDragEnd(DragEventArgs e)
    {
        isDraggingList = false;
    }

    private void HandleCardDragOver(DragEventArgs e)
    {
        e.DataTransfer.DropEffect = "move";
        isDragOverCards = true;
    }

    private void HandleCardDragLeave(DragEventArgs e)
    {
        isDragOverCards = false;
    }

    private async Task HandleCardDrop(DragEventArgs e)
    {
        isDragOverCards = false;
        var cardId = DragState.DraggedCardId;
        if (cardId.HasValue && !string.IsNullOrEmpty(userId))
        {
            try
            {
                var newPosition = cards?.Count ?? 0;
                await CardService.MoveCardAsync(cardId.Value, userId, List.Id, newPosition);
                await LoadCards();
                await OnCardMoved.InvokeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error moving card: {ex.Message}");
            }
            finally
            {
                DragState.DraggedCardId = null;
                DragState.SourceListId = null;
            }
        }
    }

    private async Task HandleCardAdded()
    {
        await LoadCards();
        StateHasChanged();
    }

    private async Task HandleCardMoved()
    {
        await LoadCards();
        StateHasChanged();
        await OnCardMoved.InvokeAsync();
    }

    private async Task HandleDelete()
    {
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                await ListService.SoftDeleteListAsync(List.Id, userId);
                await OnListReordered.InvokeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting list: {ex.Message}");
            }
        }
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private async Task HandleDeleteFromMenu()
    {
        showMenu = false;
        await HandleDelete();
    }
}
