@inherits LayoutComponentBase

<MudThemeProvider Theme="KanbanTheme.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="border-b border-line-subtle">
        <MudText Typo="Typo.h6" Class="font-semibold">Kanban</MudText>
        <MudSpacer />
        <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Class="text-ink-muted" Underline="Underline.Hover">About</MudLink>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent" Class="border-r border-line-subtle">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="px-8 pt-20 pb-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
