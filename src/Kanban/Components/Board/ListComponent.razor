@using Kanban.Services
@using Kanban.Data.Entities

<div class="list" data-list-item-id="@List.Id">
    <div class="list-header">
        <h2>
            @List.Name <span class="list-count">@(cards?.Count ?? 0)</span>
            @if (List.AssociatedState.HasValue)
            {
                <span class="state-mapping-badge" style="@StateBadgeStyle(List.AssociatedState.Value)" title="Cards dropped here are set to @CardStateStyles.Label(List.AssociatedState.Value)">@CardStateStyles.Label(List.AssociatedState.Value)</span>
            }
        </h2>
        <div class="list-menu-wrap" @onclick:stopPropagation="true">
            <button type="button" class="list-menu-btn" @onclick="ToggleMenu" title="List options">&#8943;</button>
            @if (showMenu)
            {
                <div class="list-menu-dropdown">
                    <button type="button" class="list-menu-item danger" @onclick="HandleDeleteFromMenu">Delete list</button>
                    <div class="list-menu-separator"></div>
                    <div class="list-menu-label">Sets card state to</div>
                    <button type="button" class="list-menu-item @(List.AssociatedState is null ? "active" : "")" @onclick="@(() => HandleSetAssociatedState(null))">None</button>
                    @foreach (var state in stateOptions)
                    {
                        <button type="button" class="list-menu-item @(List.AssociatedState == state ? "active" : "")" @onclick="@(() => HandleSetAssociatedState(state))">@CardStateStyles.Label(state)</button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="cards-container" data-list-id="@List.Id">
        @if (cards != null)
        {
            @foreach (var card in cards.OrderBy(c => c.Position))
            {
                <CardComponent
                    Card="card"
                    BoardId="BoardId"
                    BoardName="@BoardName"
                    OnCardMoved="HandleCardMoved"
                    @key="card.Id" />
            }
        }
        <div data-sortable-ignore="true">
            <AddCardForm ListId="List.Id" OnCardAdded="HandleCardAdded" />
        </div>
    </div>
</div>

<style>
    .list {
        background: var(--knb-bg-surface);
        border: 1px solid var(--knb-border-subtle);
        border-radius: var(--knb-radius-lg);
        min-width: 300px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: opacity 0.15s;
    }

    .list.dragging {
        opacity: 0.5;
    }

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: grab;
        user-select: none;
    }

    .list-header:active {
        cursor: grabbing;
    }

    .list-header h2 {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 15px;
        font-weight: 600;
        color: var(--knb-text-primary);
    }

    .list-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: var(--knb-radius-full);
        background: var(--knb-bg-surface-3);
        color: var(--knb-text-secondary);
        font-size: 11px;
        font-weight: 600;
    }

    .list-menu-wrap {
        position: relative;
    }

    .list-menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border: none;
        background: transparent;
        border-radius: var(--knb-radius-sm);
        color: var(--knb-text-tertiary);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
    }

        .list-menu-btn:hover {
            background: var(--knb-bg-surface-hover);
            color: var(--knb-text-primary);
        }

    .list-menu-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        z-index: 20;
        min-width: 140px;
        background: var(--knb-bg-surface);
        border: 1px solid var(--knb-border);
        border-radius: var(--knb-radius-md);
        box-shadow: var(--knb-shadow-md);
        padding: 4px;
    }

    .list-menu-item {
        display: block;
        width: 100%;
        text-align: left;
        padding: 6px 10px;
        border: none;
        background: transparent;
        border-radius: var(--knb-radius-sm);
        color: var(--knb-text-primary);
        font-size: 13px;
        cursor: pointer;
    }

        .list-menu-item:hover {
            background: var(--knb-bg-surface-hover);
        }

        .list-menu-item.active {
            font-weight: 600;
        }

        .list-menu-item.danger {
            color: var(--knb-danger);
        }

            .list-menu-item.danger:hover {
                background: var(--knb-danger-subtle);
            }

    .list-menu-separator {
        height: 1px;
        margin: 4px 0;
        background: var(--knb-border-subtle);
    }

    .list-menu-label {
        padding: 4px 10px 2px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--knb-text-tertiary);
    }

    .state-mapping-badge {
        display: inline-flex;
        align-items: center;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: 1px 6px;
        border-radius: var(--knb-radius-full);
    }

    .cards-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 50px;
        border-radius: var(--knb-radius-md);
    }
</style>

@code {
    [Parameter]
    public List List { get; set; } = null!;

    [Parameter]
    public int BoardId { get; set; }

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnCardMoved { get; set; }

    [Parameter]
    public EventCallback OnListReordered { get; set; }

    [Inject]
    private IListService ListService { get; set; } = null!;

    [Inject]
    private ICardService CardService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private static readonly CardState[] stateOptions = [CardState.NotStarted, CardState.InProgress, CardState.Done];

    private List<Card>? cards;
    private string? userId;
    private bool showMenu = false;

    private static string StateBadgeStyle(CardState state)
    {
        var (fg, bg) = CardStateStyles.Colors(state);
        return $"color:{fg};background-color:{bg}";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadCards();
    }

    private async Task LoadCards()
    {
        if (string.IsNullOrEmpty(userId)) return;

        try
        {
            cards = await CardService.GetListCardsAsync(List.Id, userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cards: {ex.Message}");
        }
    }

    private async Task HandleCardAdded()
    {
        await LoadCards();
        StateHasChanged();
    }

    private async Task HandleCardMoved()
    {
        await LoadCards();
        StateHasChanged();
        await OnCardMoved.InvokeAsync();
    }

    private async Task HandleDelete()
    {
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                await ListService.SoftDeleteListAsync(List.Id, userId);
                await OnListReordered.InvokeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting list: {ex.Message}");
            }
        }
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private async Task HandleDeleteFromMenu()
    {
        showMenu = false;
        await HandleDelete();
    }

    private async Task HandleSetAssociatedState(CardState? state)
    {
        showMenu = false;
        if (string.IsNullOrEmpty(userId))
            return;

        try
        {
            await ListService.SetAssociatedStateAsync(List.Id, userId, state);
            List.AssociatedState = state;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting list state mapping: {ex.Message}");
        }
    }
}
