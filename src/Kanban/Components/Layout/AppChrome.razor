<MudAppBar Elevation="0" Class="border-b border-line-subtle">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
    <MudText Typo="Typo.h6" Class="font-semibold">Kanban</MudText>
    <MudSpacer />
    <ThemeToggle />
    <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Class="text-ink-muted" Underline="Underline.Hover">About</MudLink>
</MudAppBar>
<MudDrawer @bind-Open="_drawerOpen" Fixed="true" Elevation="0" Variant="DrawerVariant.Responsive" Class="border-r border-line-subtle">
    <NavMenu />
</MudDrawer>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
