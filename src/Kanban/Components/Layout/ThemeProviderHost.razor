@using Kanban.Services
@using Kanban.Theme
@inject ThemeState ThemeState
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="KanbanTheme.Theme" IsDarkMode="ThemeState.IsDarkMode" />

@code {
    protected override void OnInitialized()
    {
        ThemeState.Changed += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Each @rendermode="InteractiveServer" root in MainLayout (this one, ThemeToggle,
            // MudDialogProvider, ...) gets its own circuit rather than sharing one -- so
            // ThemeState here is local to THIS instance, not shared with the toggle button's.
            // Read the real preference from JS on every fresh mount instead of relying on
            // another component's state. (The data-theme DOM attribute driving the app's own
            // --knb-* CSS tokens is handled separately by the MutationObserver in App.razor;
            // this only needs to bring MudThemeProvider's IsDarkMode into agreement.)
            var theme = await JS.InvokeAsync<string>("knbGetTheme");
            ThemeState.SetDarkMode(theme == "dark");
        }
    }

    public void Dispose()
    {
        ThemeState.Changed -= StateHasChanged;
    }
}
