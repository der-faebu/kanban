@using Kanban.Services
@inject ThemeState ThemeState
@inject IJSRuntime JS
@implements IDisposable

<MudIconButton Icon="@(ThemeState.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
               OnClick="Toggle"
               title="@(ThemeState.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")" />

@code {
    protected override void OnInitialized()
    {
        ThemeState.Changed += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // This component gets its own circuit, separate from ThemeProviderHost's (see
            // that component's comment) -- bootstrap from the real stored preference here too,
            // so the icon/tooltip reflect reality instead of always assuming light on mount.
            var theme = await JS.InvokeAsync<string>("knbGetTheme");
            ThemeState.SetDarkMode(theme == "dark");
        }
    }

    private async Task Toggle()
    {
        var next = !ThemeState.IsDarkMode;
        ThemeState.SetDarkMode(next);
        await JS.InvokeVoidAsync("knbSetTheme", next ? "dark" : "light");
    }

    public void Dispose()
    {
        ThemeState.Changed -= StateHasChanged;
    }
}
