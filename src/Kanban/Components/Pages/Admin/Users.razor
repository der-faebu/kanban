@page "/admin/users"
@rendermode InteractiveServer
@using Kanban.Services
@attribute [Authorize(Policy = AdminRoleSeeder.AdminPolicyName)]

@inject IAdminUserService AdminUserService

<PageTitle>Admin - Users</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudText Typo="Typo.h4" Class="mb-6">Users</MudText>

    @if (!string.IsNullOrEmpty(deleteErrorMessage))
    {
        <MudAlert Class="delete-error mb-4" Severity="Severity.Error" CloseIconClicked="@(() => deleteErrorMessage = null)" ShowCloseIcon="true">@deleteErrorMessage</MudAlert>
    }

    <MudTextField T="string" Value="@searchTerm" ValueChanged="OnSearchChanged" Immediate="true" Label="Search by email" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

    @if (users is null)
    {
        <MudText>Loading...</MudText>
    }
    else
    {
        <MudTable Items="@users" Filter="new Func<AdminUserSummary, bool>(FilterUser)" Hover="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Login methods</MudTh>
                <MudTh>Admin</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Login methods">@string.Join(", ", LoginMethods(context))</MudTd>
                <MudTd DataLabel="Admin">@(context.IsAdmin ? "Yes" : "No")</MudTd>
                <MudTd DataLabel="Status">@(context.IsLockedOut ? "Locked out" : "Active")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Class="admin-toggle" Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleAdminAsync(context))">
                        @(context.IsAdmin ? "Demote" : "Promote")
                    </MudButton>
                    <MudButton Class="lockout-toggle" Size="Size.Small" Variant="Variant.Text" Color="@(context.IsLockedOut ? Color.Success : Color.Error)" OnClick="@(() => ToggleLockoutAsync(context))">
                        @(context.IsLockedOut ? "Unlock" : "Lock")
                    </MudButton>
                    <MudButton Class="delete-user" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteUserAsync(context))">
                        Delete
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No users match your search.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<AdminUserSummary>? users;
    private string searchTerm = "";
    private string? deleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        users = await AdminUserService.GetUsersAsync();
    }

    private void OnSearchChanged(string value)
    {
        searchTerm = value;
    }

    private bool FilterUser(AdminUserSummary user) =>
        string.IsNullOrWhiteSpace(searchTerm) || user.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<string> LoginMethods(AdminUserSummary user)
    {
        if (user.HasPassword) yield return "Password";
        if (user.HasPasskey) yield return "Passkey";
        if (user.HasEntraLogin) yield return "Entra";
    }

    private async Task ToggleAdminAsync(AdminUserSummary user)
    {
        try
        {
            var isAdmin = !user.IsAdmin;
            await AdminUserService.SetAdminRoleAsync(user.Id, isAdmin);
            ReplaceUser(user with { IsAdmin = isAdmin });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating admin role: {ex.Message}");
        }
    }

    private async Task ToggleLockoutAsync(AdminUserSummary user)
    {
        try
        {
            var lockedOut = !user.IsLockedOut;
            await AdminUserService.SetLockedOutAsync(user.Id, lockedOut);
            ReplaceUser(user with { IsLockedOut = lockedOut });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating lockout: {ex.Message}");
        }
    }

    private async Task DeleteUserAsync(AdminUserSummary user)
    {
        try
        {
            deleteErrorMessage = null;
            await AdminUserService.DeleteUserAsync(user.Id);
            users!.RemoveAll(u => u.Id == user.Id);
        }
        catch (InvalidOperationException ex)
        {
            deleteErrorMessage = ex.Message;
        }
    }

    private void ReplaceUser(AdminUserSummary updated)
    {
        var index = users!.FindIndex(u => u.Id == updated.Id);
        users[index] = updated;
    }
}
