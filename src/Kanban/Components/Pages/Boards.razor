@page "/boards"
@rendermode InteractiveServer
@using Kanban.Services
@using Kanban.Data.Entities
@using Kanban.Data.Dtos
@using Kanban.Components.Board
@attribute [Authorize]

<PageTitle>Boards</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <MudText Typo="Typo.h4">My Boards</MudText>
        <div class="flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ToggleNewBoardForm">New Board</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="ToggleImportForm">Import from Trello</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Restore" OnClick="ToggleKanbanImportForm">Restore from export</MudButton>
        </div>
    </div>

    @if (showNewBoardForm)
    {
        <MudPaper Outlined="true" Class="mb-6 pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Create New Board</MudText>
            <EditForm Model="newBoard" OnValidSubmit="HandleCreateBoard" class="flex flex-col gap-3">
                <MudTextField @bind-Value="newBoard.Name" Label="Board Name" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Required="true" />
                <MudTextField @bind-Value="newBoard.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Lines="2" />
                <div class="flex gap-2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ToggleNewBoardForm">Cancel</MudButton>
                </div>
            </EditForm>
        </MudPaper>
    }

    @if (showImportForm)
    {
        <MudPaper Outlined="true" Class="mb-6 pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Import Trello Board</MudText>
            <MudText Typo="Typo.body2" Class="text-ink-muted mb-3">Importing always creates a new board from the Trello export.</MudText>
            <ImportTrelloForm OnImportComplete="HandleImportComplete" />
            <MudButton Variant="Variant.Text" OnClick="ToggleImportForm" Class="mt-3">Cancel</MudButton>
        </MudPaper>
    }

    @if (showKanbanImportForm)
    {
        <MudPaper Outlined="true" Class="mb-6 pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Restore Board from Export</MudText>
            <MudText Typo="Typo.body2" Class="text-ink-muted mb-3">Restoring always creates a new board from the export zip; it never overwrites an existing board.</MudText>
            <ImportKanbanExportForm OnImportComplete="HandleKanbanImportComplete" />
            <MudButton Variant="Variant.Text" OnClick="ToggleKanbanImportForm" Class="mt-3">Cancel</MudButton>
        </MudPaper>
    }

    @if (boards != null && boards.Count > 0)
    {
        <MudGrid>
            @foreach (var board in boards)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Outlined="true" Class="board-card flex h-full flex-col">
                        <MudCardContent Class="flex-1">
                            <MudLink Href="@($"/board/{board.Id}")" Underline="Underline.None" Class="block text-lg font-semibold">@board.Name</MudLink>
                            @if (!string.IsNullOrEmpty(board.Description))
                            {
                                <MudText Typo="Typo.body2" Class="text-ink-muted mt-1">@board.Description</MudText>
                            }
                            <span class="board-created-pill">Created @board.CreatedAt.ToShortDateString()</span>
                        </MudCardContent>
                        <MudCardActions Class="px-4 pb-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@($"/board/{board.Id}")">Open</MudButton>
                            @if (IsOwner(board))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => HandleDeleteBoard(board.Id)">Delete</MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (loading)
    {
        <MudText Class="text-ink-muted">Loading boards...</MudText>
    }
    else
    {
        <MudText Class="text-ink-muted">
            No boards yet.
            <MudLink OnClick="ToggleNewBoardForm" Class="cursor-pointer">Create one</MudLink>
        </MudText>
    }
</MudContainer>

<style>
    .board-card {
        transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
    }

    .board-card:hover {
        border-color: var(--knb-border-strong);
        box-shadow: var(--knb-shadow-md);
        transform: translateY(-2px);
    }

    .board-created-pill {
        display: inline-flex;
        margin-top: 10px;
        font-size: 11px;
        color: var(--knb-text-tertiary);
        background: var(--knb-bg-surface-3);
        padding: 1px 8px;
        border-radius: var(--knb-radius-full);
    }
</style>

@code {
    [Inject]
    private IBoardService BoardService { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private List<Board>? boards;
    private bool loading = true;
    private bool showNewBoardForm = false;
    private bool showImportForm = false;
    private bool showKanbanImportForm = false;
    private string? userId;
    private Board newBoard = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        await LoadBoards();
        loading = false;
    }

    private async Task LoadBoards()
    {
        try
        {
            boards = await BoardService.GetUserBoardsAsync(userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading boards: {ex.Message}");
        }
    }

    private void ToggleNewBoardForm()
    {
        showNewBoardForm = !showNewBoardForm;
        if (!showNewBoardForm)
        {
            newBoard = new();
        }
    }

    private async Task HandleCreateBoard()
    {
        if (string.IsNullOrWhiteSpace(newBoard.Name) || string.IsNullOrEmpty(userId))
            return;

        try
        {
            await BoardService.CreateBoardAsync(userId, newBoard.Name, newBoard.Description);
            await LoadBoards();
            showNewBoardForm = false;
            newBoard = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating board: {ex.Message}");
        }
    }

    private async Task HandleDeleteBoard(int boardId)
    {
        if (string.IsNullOrEmpty(userId))
            return;

        try
        {
            await BoardService.DeleteBoardAsync(boardId, userId);
            await LoadBoards();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting board: {ex.Message}");
        }
    }

    private bool IsOwner(Board board)
    {
        return board.OwnerId == userId;
    }

    private void ToggleImportForm()
    {
        showImportForm = !showImportForm;
    }

    private async Task HandleImportComplete(TrelloImportResult result)
    {
        if (result.Success)
        {
            await LoadBoards();
            showImportForm = false;
        }
    }

    private void ToggleKanbanImportForm()
    {
        showKanbanImportForm = !showKanbanImportForm;
    }

    private async Task HandleKanbanImportComplete(BoardImportResult result)
    {
        if (result.Success)
        {
            await LoadBoards();
            showKanbanImportForm = false;
        }
    }
}
